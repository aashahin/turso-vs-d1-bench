{
  "name": "turso-vs-d1-bench",
  "type": "module",
  "private": true,
  "scripts": {
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --remote",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:secret:turso": "wrangler secret put TURSO_TOKEN --config worker/wrangler.jsonc",
    "worker:secret:tursodb": "wrangler secret put TURSODB_TOKEN --config worker/wrangler.jsonc",
    "worker:secret:admin": "wrangler secret put ADMIN_TOKEN --config worker/wrangler.jsonc",
    "seed": "bun src/seed.ts",
    "seed:lms": "bun src/seed.ts --tenants=10 --students-per-tenant=200 --courses-per-tenant=5 --lessons-per-course=10 --rows=10000",
    "bench": "bun src/bench.ts",
    "bench:turso-next": "bun src/bench.ts --backends=turso-reused,tursodb-reused,tursodb-concurrent,d1-eeur --tests=point-read,insert,independent-writes,hot-row-write --workload=lms --tenant-mode=single --duration=30 --iterations=20000 --concurrency=1,10,50,100,200 --runs=1 --write-retries=3 --out=results-tursodb.json",
    "bench:quick": "bun src/bench.ts --iterations=20 --concurrency=1 --warmup=5 --tests=point-read,scan",
    "bench:single": "bun src/bench.ts --backends=d1,d1-eeur,turso,turso-reused,d1-rr,d1-eeur-rr --tests=point-read,scan,lesson-page,mixed --workload=lms --scan-limits=100 --tenant-mode=single --duration=60 --concurrency=1,5,10,25,50,100,200 --runs=5",
    "bench:2h": "bun src/bench.ts --backends=d1,d1-eeur,turso-reused,d1-rr --tests=lesson-page,mixed --workload=lms --tenant-mode=single --duration=60 --concurrency=1,10,50,200 --runs=3",
    "bench:distributed": "bun src/bench.ts --backends=d1,d1-eeur --tests=lesson-page,mixed --workload=lms --tenant-mode=distributed --tenant-count=10,50,100 --duration=60 --concurrency=50,100,200 --runs=5",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "wrangler": "4.128.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@tursodatabase/serverless": "^1.4.0",
    "drizzle-orm": "0.44.7"
  }
}
