# Client (bun bench + seed). Env vars take precedence over CLI flags.
# Existing Turso Cloud / libSQL database (turso-reused).
TURSO_URL=https://bench-turso-vs-d1-aashahin.aws-eu-west-1.turso.io
TURSO_TOKEN=<turso db tokens create bench-turso-vs-d1>
# New Turso Database engine (tursodb-reused / tursodb-concurrent).
# Must be a tursodb database: turso db create --tursodb bench-tursodb --group manhali
TURSODB_URL=https://bench-tursodb-aashahin.aws-eu-west-1.turso.io
TURSODB_TOKEN=<turso db tokens create bench-tursodb>
ADMIN_TOKEN=<shared secret, also set via: bun run worker:secret:admin>
WORKER_URL=http://127.0.0.1:8787
# Optional overrides (defaults shown). CLI flags work too: --tenants=10 ...
#TENANTS=10
#STUDENTS_PER_TENANT=200
#COURSES_PER_TENANT=5
#LESSONS_PER_COURSE=10
#ROWS=10000
#CONCURRENCY=1,10,50
#DURATION=0
#RUNS=1
#WRITE_RETRIES=3
#OUT=results-tursodb.json
